pager                   "less -R %f"

color listfocus         black white
color listfocus_unread  black white
color info              black cyan
color listnormal        white black dim
color listnormal_unread white black

reload-threads          4
show-keymap-hint        no
swap-title-and-hints    yes
cleanup-on-quit         yes

auto-reload             yes
reload-time             30

browser                 "xdg-open %u"
macro o                 set browser "w3m %u"; open-in-browser; set browser "xdg-open %u"
